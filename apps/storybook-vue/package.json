{
  "name": "@workspace/storybook-vue",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "storybook dev --port 4174 --host 127.0.0.1 --ci --no-open",
    "build": "vue-tsc --noEmit && storybook build --output-dir dist --disable-telemetry",
    "typecheck": "vue-tsc --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@workspace/test-infra": "workspace:*",
    "@aifuxi/semi-theme-default": "workspace:*",
    "@aifuxi/semi-icons-vue": "workspace:*",
    "@aifuxi/semi-icons-lab-vue": "workspace:*",
    "@aifuxi/semi-illustrations-vue": "workspace:*",
    "@aifuxi/semi-ui-vue": "workspace:*",
    "normalize.css": "catalog:",
    "typeface-inter": "catalog:",
    "vue": "catalog:"
  },
  "devDependencies": {
    "@storybook/vue3-vite": "10.6.0",
    "storybook": "10.6.0"
  }
}
