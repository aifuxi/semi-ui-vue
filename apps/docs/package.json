{
  "name": "@workspace/docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:packages": "pnpm -w build:public-js && pnpm --filter @aifuxi/semi-theme-default build",
    "prepare:assets": "node scripts/prepare-assets.mjs",
    "prepare:content": "node scripts/prepare-content.mjs",
    "prepare:site": "pnpm prepare:assets && pnpm prepare:content",
    "dev": "pnpm prepare:site && vitepress dev . --port 4321 --host 127.0.0.1",
    "build": "pnpm prepare:site && vitepress build .",
    "preview": "vitepress preview . --port 4321 --host 127.0.0.1",
    "typecheck": "pnpm prepare:site && vue-tsc --noEmit -p tsconfig.json",
    "clean": "rimraf content dist cache .vitepress/theme/generated"
  },
  "dependencies": {
    "@aifuxi/semi-icons-lab-vue": "workspace:*",
    "@aifuxi/semi-icons-vue": "workspace:*",
    "@aifuxi/semi-illustrations-vue": "workspace:*",
    "@aifuxi/semi-theme-default": "workspace:*",
    "@aifuxi/semi-ui-vue": "workspace:*",
    "prismjs": "1.30.0",
    "vitepress": "1.6.4",
    "vue": "catalog:"
  },
  "devDependencies": {
    "@douyinfe/semi-site-doc-style": "0.0.5",
    "rimraf": "6.1.3",
    "sass-legacy": "npm:sass@1.54.9",
    "typeface-inconsolata": "1.1.13",
    "vue-tsc": "3.3.11",
    "yaml": "2.9.0"
  }
}
