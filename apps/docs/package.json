{
  "name": "@workspace/docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:packages": "pnpm -w build:public-js && pnpm --filter @aifuxi/semi-theme-default --filter @aifuxi/semi-theme-modern build",
    "prepare:index": "node scripts/prepare-index.mjs",
    "prepare:site": "pnpm prepare:index",
    "dev": "pnpm prepare:site && vitepress dev . --port 4321 --host 127.0.0.1",
    "build": "pnpm prepare:site && vitepress build .",
    "preview": "vitepress preview . --port 4321 --host 127.0.0.1",
    "typecheck": "pnpm prepare:packages && pnpm prepare:site && vue-tsc --noEmit -p tsconfig.json",
    "clean": "rimraf dist cache .vitepress/theme/generated content/public/search-index.json"
  },
  "dependencies": {
    "@aifuxi/semi-icons-lab-vue": "workspace:*",
    "@aifuxi/semi-icons-vue": "workspace:*",
    "@aifuxi/semi-illustrations-vue": "workspace:*",
    "@aifuxi/semi-theme-default": "workspace:*",
    "@aifuxi/semi-theme-modern": "workspace:*",
    "@aifuxi/semi-ui-vue": "workspace:*",
    "prismjs": "1.30.0",
    "vitepress": "1.6.4",
    "vue": "catalog:"
  },
  "devDependencies": {
    "rimraf": "6.1.3",
    "vue-tsc": "3.3.11",
    "yaml": "2.9.0"
  }
}
