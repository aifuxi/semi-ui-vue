{
  "name": "semi-ui-vue-workspace",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aifuxi/semi-ui-vue.git"
  },
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || ^24.0.0",
    "pnpm": "11.19.0"
  },
  "scripts": {
    "dev": "pnpm dev:docs",
    "dev:docs": "pnpm --filter @workspace/docs dev",
    "dev:parity": "pnpm --filter @workspace/parity-vue dev",
    "dev:reference": "pnpm --filter @workspace/reference-react dev",
    "build": "pnpm -r --if-present run build",
    "build:public-js": "pnpm --filter @aifuxi/semi-ui-vue --filter @aifuxi/semi-icons-vue --filter @aifuxi/semi-icons-lab-vue --filter @aifuxi/semi-illustrations-vue run build",
    "clean": "pnpm -r --if-present run clean && rimraf coverage playwright-report test-results",
    "check:vendor": "node scripts/verify-vendor.mjs",
    "inventory:generate": "node scripts/generate-upstream-inventory.mjs",
    "icons:generate": "node scripts/generate-icons.mjs",
    "illustrations:generate": "node scripts/generate-illustrations.mjs",
    "locales:generate": "node scripts/generate-locales.mjs",
    "check:icons": "node scripts/generate-icons.mjs --check",
    "check:illustrations": "node scripts/generate-illustrations.mjs --check",
    "check:locales": "node scripts/generate-locales.mjs --check",
    "check:inventory": "node scripts/generate-upstream-inventory.mjs --check",
    "check:boundaries": "node scripts/verify-source-boundaries.mjs",
    "check:docs": "pnpm --filter @workspace/docs check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --concurrency auto --max-warnings=0",
    "typecheck": "pnpm typecheck:root && pnpm -r --if-present run typecheck",
    "typecheck:clean": "pnpm clean && pnpm typecheck",
    "typecheck:root": "tsc -p tsconfig.tools.json --noEmit",
    "test": "pnpm test:unit",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "verify:theme-dist": "node scripts/verify-theme.mjs",
    "test:theme": "pnpm check:vendor && pnpm --filter @aifuxi/semi-theme-default build && pnpm verify:theme-dist",
    "verify:pack-dist": "node scripts/verify-pack.mjs",
    "test:pack": "pnpm build && pnpm verify:theme-dist && pnpm verify:pack-dist",
    "test:browser": "playwright test tests/browser",
    "test:browser:docs": "pnpm --filter @workspace/docs test:browser",
    "playwright:install": "playwright install chromium",
    "verify:ssr-dist": "node scripts/verify-ssr-import.mjs",
    "test:ssr": "pnpm build:public-js && pnpm verify:ssr-dist",
    "audit:prod": "pnpm --registry=https://registry.npmjs.org/ audit --prod --audit-level=moderate",
    "release:bump": "node scripts/release-bump.mjs",
    "release:verify": "node scripts/verify-release.mjs",
    "release:preflight": "pnpm release:verify && node scripts/release-preflight.mjs",
    "release:publish": "node scripts/publish-packages.mjs",
    "release:check": "pnpm audit:prod && pnpm check:full && pnpm release:verify",
    "check": "pnpm check:vendor && pnpm check:inventory && pnpm check:icons && pnpm check:illustrations && pnpm check:locales && pnpm check:boundaries && pnpm --filter @workspace/docs check:content && pnpm format:check && pnpm lint && pnpm typecheck:clean && pnpm test:unit && pnpm build && pnpm --filter @workspace/docs check:dist && pnpm verify:theme-dist && pnpm verify:ssr-dist && pnpm verify:pack-dist",
    "check:full": "pnpm check && pnpm test:browser && pnpm test:browser:docs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "20.19.43",
    "@vitejs/plugin-react": "6.1.0",
    "@vitejs/plugin-vue": "6.0.8",
    "@vitest/coverage-v8": "4.1.11",
    "@vue/server-renderer": "3.5.41",
    "@vue/test-utils": "2.4.11",
    "@workspace/foundation-integration": "workspace:*",
    "async-validator": "3.5.2",
    "bezier-easing": "2.1.0",
    "classnames": "2.5.1",
    "date-fns": "2.30.0",
    "date-fns-tz": "1.3.8",
    "eslint": "10.0.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.10.0",
    "globals": "17.11.0",
    "jsdom": "26.1.0",
    "lodash": "4.18.1",
    "lottie-web": "5.13.0",
    "prettier": "3.9.6",
    "prismjs": "1.30.0",
    "rimraf": "6.1.3",
    "scroll-into-view-if-needed": "2.2.31",
    "semver": "7.8.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.2",
    "vite-plugin-dts": "5.0.3",
    "vitest": "4.1.11",
    "vue": "3.5.41",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.11"
  }
}
