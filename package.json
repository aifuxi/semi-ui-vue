{
  "name": "semi-ui-vue-workspace",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aifuxi/semi-ui-vue.git"
  },
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": "24.18.0",
    "pnpm": "12.3.4"
  },
  "scripts": {
    "dev": "pnpm --filter @workspace/storybook-vue dev",
    "dev:reference": "pnpm --filter @workspace/reference-react dev",
    "docs:prepare": "pnpm --filter @workspace/docs run prepare:packages",
    "docs:dev": "pnpm --filter @workspace/docs run dev",
    "docs:build": "pnpm --filter @workspace/docs run build",
    "build": "pnpm build:public-js && pnpm --filter @aifuxi/semi-theme-default build",
    "build:storybook": "pnpm --filter @workspace/storybook-vue build",
    "build:public-js": "pnpm --filter @aifuxi/semi-ui-vue --filter @aifuxi/semi-icons-vue --filter @aifuxi/semi-icons-lab-vue --filter @aifuxi/semi-illustrations-vue run build",
    "clean": "pnpm -r --if-present run clean && rimraf coverage playwright-report test-results",
    "check:vendor": "node scripts/verify-vendor.mjs",
    "inventory:generate": "node scripts/generate-upstream-inventory.mjs",
    "icons:generate": "node scripts/generate-icons.mjs",
    "illustrations:generate": "node scripts/generate-illustrations.mjs",
    "locales:generate": "node scripts/generate-locales.mjs",
    "check:icons": "node scripts/generate-icons.mjs --check",
    "check:illustrations": "node scripts/generate-illustrations.mjs --check",
    "check:locales": "node scripts/generate-locales.mjs --check",
    "check:inventory": "node scripts/generate-upstream-inventory.mjs --check",
    "check:boundaries": "node scripts/verify-source-boundaries.mjs",
    "check:slots": "node scripts/verify-slot-render-usage.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --concurrency auto --max-warnings=0",
    "typecheck": "pnpm typecheck:root && pnpm -r --if-present run typecheck",
    "typecheck:source": "pnpm typecheck",
    "typecheck:clean": "pnpm run clean && pnpm typecheck",
    "typecheck:root": "tsc -p tsconfig.tools.json --noEmit",
    "test": "pnpm test:unit",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:coverage:all": "COVERAGE_ALL=1 vitest run --coverage",
    "verify:theme-dist": "node scripts/verify-theme.mjs",
    "test:theme": "pnpm check:vendor && pnpm --filter @aifuxi/semi-theme-default build && pnpm verify:theme-dist",
    "verify:pack-dist": "node scripts/verify-pack.mjs",
    "verify:pack-isolated": "PACK_ISOLATED=1 node scripts/verify-pack.mjs",
    "test:pack": "pnpm build && pnpm verify:theme-dist && pnpm verify:pack-dist",
    "test:browser": "playwright test tests/browser",
    "test:browser:dev": "PARITY_SERVER_MODE=dev playwright test tests/browser",
    "test:consumer": "playwright test --config playwright.consumer.config.ts",
    "playwright:install": "playwright install chromium",
    "playwright:cli": "playwright cli",
    "verify:ssr-dist": "node scripts/verify-ssr-import.mjs",
    "test:ssr": "pnpm build:public-js && pnpm verify:ssr-dist",
    "audit:prod": "pnpm --registry=https://registry.npmjs.org/ audit --prod --audit-level=moderate",
    "changeset": "changeset",
    "release:version": "changeset version && pnpm install --lockfile-only --ignore-scripts",
    "check:changesets": "node scripts/verify-changesets.mjs",
    "test:changesets": "node --test scripts/*.integration.mjs",
    "release:verify": "node scripts/verify-release.mjs",
    "release:postcheck": "node scripts/release-postcheck.mjs",
    "release:check": "pnpm test:changesets && pnpm audit:prod && PACK_ISOLATED=1 pnpm check:full && pnpm release:verify",
    "check:source": "pnpm check:toolchain && pnpm check:vendor && pnpm check:inventory && pnpm check:icons && pnpm check:illustrations && pnpm check:locales && pnpm check:boundaries && pnpm check:slots && pnpm format:check && pnpm lint && pnpm typecheck:source",
    "check": "pnpm check:source && pnpm test:unit",
    "check:artifacts": "pnpm build && pnpm verify:theme-dist && pnpm verify:ssr-dist && pnpm verify:pack-dist",
    "check:full": "pnpm check && pnpm check:artifacts && pnpm test:browser && pnpm test:consumer",
    "check:toolchain": "node scripts/verify-toolchain.mjs"
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.2",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@rsbuild/core": "2.2.5",
    "@rsbuild/plugin-react": "2.1.0",
    "@rsbuild/plugin-vue": "2.0.1",
    "@rslib/core": "1.0.0",
    "@storybook/vue3-vite": "10.6.0",
    "@types/node": "24.13.4",
    "@vitejs/plugin-vue": "6.0.8",
    "@vitest/coverage-v8": "5.0.0",
    "@vue/server-renderer": "3.5.41",
    "@vue/test-utils": "2.4.11",
    "@workspace/foundation-integration": "workspace:*",
    "async-validator": "3.5.2",
    "bezier-easing": "2.1.0",
    "classnames": "2.5.1",
    "date-fns": "2.30.0",
    "date-fns-tz": "1.3.8",
    "eslint": "10.0.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.10.0",
    "globals": "17.11.0",
    "jiti": "2.6.1",
    "jsdom": "26.1.0",
    "lodash": "4.18.1",
    "lottie-web": "5.13.0",
    "prettier": "3.9.6",
    "prismjs": "1.30.0",
    "rimraf": "6.1.3",
    "sass": "1.104.0",
    "scroll-into-view-if-needed": "2.2.31",
    "semver": "7.8.5",
    "storybook": "10.6.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0",
    "unplugin": "3.3.0",
    "verdaccio": "6.10.3",
    "vite": "8.2.2",
    "vitest": "5.0.0",
    "vue": "3.5.41",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.11"
  }
}
