{
  "name": "semi-ui-vue-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || ^24.0.0",
    "pnpm": "11.19.0"
  },
  "scripts": {
    "dev": "pnpm dev:docs",
    "dev:docs": "pnpm --filter @workspace/docs-vue dev",
    "dev:reference": "pnpm --filter @workspace/reference-react dev",
    "build": "pnpm -r --if-present run build",
    "build:public-js": "pnpm --filter @workspace/ui --filter @workspace/icons --filter @workspace/icons-lab --filter @workspace/illustrations run build",
    "clean": "pnpm -r --if-present run clean && rimraf coverage playwright-report test-results",
    "check:vendor": "node scripts/verify-vendor.mjs",
    "inventory:generate": "node scripts/generate-upstream-inventory.mjs",
    "check:inventory": "node scripts/generate-upstream-inventory.mjs --check",
    "check:boundaries": "node scripts/verify-source-boundaries.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "pnpm typecheck:root && pnpm -r --if-present run typecheck",
    "typecheck:root": "tsc -p tsconfig.tools.json --noEmit",
    "test": "pnpm test:unit",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "verify:theme-dist": "node scripts/verify-theme.mjs",
    "test:theme": "pnpm check:vendor && pnpm --filter @workspace/theme-default build && pnpm verify:theme-dist",
    "verify:pack-dist": "node scripts/verify-pack.mjs",
    "test:pack": "pnpm build && pnpm verify:theme-dist && pnpm verify:pack-dist",
    "test:browser": "playwright test tests/browser",
    "playwright:install": "playwright install chromium",
    "verify:ssr-dist": "node scripts/verify-ssr-import.mjs",
    "test:ssr": "pnpm build:public-js && pnpm verify:ssr-dist",
    "check": "pnpm check:vendor && pnpm check:inventory && pnpm check:boundaries && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:unit && pnpm build && pnpm verify:theme-dist && pnpm verify:ssr-dist && pnpm verify:pack-dist",
    "check:full": "pnpm check && pnpm test:browser"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "20.19.43",
    "@vitejs/plugin-react": "6.1.0",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/server-renderer": "3.5.41",
    "@vue/test-utils": "2.4.11",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.0.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.10.0",
    "globals": "17.11.0",
    "jsdom": "26.1.0",
    "prettier": "3.9.6",
    "rimraf": "6.1.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.2",
    "vite-plugin-dts": "5.0.3",
    "vitest": "4.1.11",
    "vue": "3.5.41",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.11"
  }
}
