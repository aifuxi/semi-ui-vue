{
  "id": "highlight",
  "upstream": "show/highlight",
  "title": "Highlight 文档",
  "spec": "highlight-matrix.spec.ts",
  "locales": ["zh-cn", "en-us"],
  "themes": ["light", "dark"],
  "examples": [
    {
      "index": 1,
      "name": "Basic",
      "zhCN": "highlight/zh-cn/Basic",
      "enUS": "highlight/en-us/Basic",
      "notes": "保留各语言 sourceString/searchWords 与 h2 包裹，默认 mark 高亮。"
    },
    {
      "index": 2,
      "name": "Style",
      "zhCN": "highlight/zh-cn/Style",
      "enUS": "highlight/en-us/Style",
      "notes": "保留各语言原高亮样式；React 数字尺寸按迁移表写成带单位 CSS 字符串。"
    },
    {
      "index": 3,
      "name": "Keywords",
      "zhCN": "highlight/zh-cn/Keywords",
      "enUS": "highlight/en-us/Keywords",
      "notes": "保留三个关键词的独立 className/style 与 component=span。"
    },
    {
      "index": 4,
      "name": "Tag",
      "zhCN": "highlight/zh-cn/Tag",
      "enUS": "highlight/en-us/Tag",
      "notes": "保留 component=strong 自定义高亮标签。"
    }
  ],
  "inputs": [
    "pnpm-lock.yaml",
    "package.json",
    "apps/docs/package.json",
    "apps/docs/nuxt.config.ts",
    "apps/docs/modules",
    "patches/@nuxt__rspack-builder@4.5.2.patch",
    "apps/docs/content/zh-cn/components/highlight.md",
    "apps/docs/content/en-us/components/highlight.md",
    "apps/docs/src/demos/highlight",
    "apps/docs/src/assets",
    "apps/docs/src/components",
    "apps/docs/scripts/prepare-*.mjs",
    "apps/docs/scripts/repl-module-bundles.mjs",
    "apps/docs/scripts/repl-rslib-factories.mjs",
    "apps/docs/scripts/*-loader.mjs",
    "apps/docs/scripts/static-file-response.mjs",
    "apps/docs/scripts/preview-static.mjs",
    "apps/docs/scripts/verify-dist.mjs",
    "apps/docs/scripts/verify-content.mjs",
    "apps/docs/scripts/accept-documentation-batch.mjs",
    "apps/docs/scripts/documentation-evidence.mjs",
    "apps/docs/scripts/documentation-inputs.mjs",
    "apps/docs/scripts/documentation-pipeline.mjs",
    "apps/docs/scripts/documentation-preparation-cache.mjs",
    "apps/docs/playwright.nuxt.config.ts",
    "apps/docs/playwright.config.ts",
    "packages/icons/src",
    "packages/theme-default",
    "tests/browser/parity-harness.ts",
    "docs/documentation/batches/highlight.json",
    "docs/documentation/mappings/highlight.json",
    "docs/documentation/highlight-acceptance.md",
    "packages/test-infra/src",
    "apps/docs/content.config.ts",
    "apps/docs/tests/nuxt/highlight-matrix.spec.ts",
    "apps/docs/tests/nuxt/demo-parity.ts",
    "apps/docs/tests/nuxt/visual-context.ts",
    "apps/docs/src/composables",
    "apps/docs/src/layouts",
    "apps/docs/src/pages",
    "apps/docs/src/app.vue",
    "apps/docs/public/theme.js",
    "apps/docs/src/data/api/types.ts",
    "apps/docs/src/data/docs.ts",
    "apps/docs/src/data/demos.ts",
    "apps/reference-react/package.json",
