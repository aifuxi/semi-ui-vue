    "packages/ui/tsconfig.build.json",
    "scripts/prune-ui-declarations.mjs",
    "packages/icons/package.json",
    "packages/icons/rslib.config.ts",
    "packages/icons-lab",
    "packages/illustrations",
    "apps/reference-react/src/semi-reference-theme.scss",
    "apps/docs/src/data/api/helpers.ts",
    "pnpm-workspace.yaml",
    "tsconfig.base.json",
