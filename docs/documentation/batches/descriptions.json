{
  "id": "descriptions",
  "upstream": "show/descriptions",
  "title": "Descriptions 文档",
  "spec": "descriptions-matrix.spec.ts",
  "locales": ["zh-cn", "en-us"],
  "themes": ["light", "dark"],
  "examples": [
    {
      "index": 1,
      "name": "Basic",
      "zhCN": "descriptions/zh-cn/Basic",
      "enUS": "descriptions/en-us/Basic",
      "notes": "data 数组的 ReactNode/render function 以 Vue h() 提供；中文保留 IconArrowUp，英文按固定上游不带箭头。"
    },
    {
      "index": 2,
      "name": "Alignment",
      "zhCN": "descriptions/zh-cn/Alignment",
      "enUS": "descriptions/en-us/Alignment",
      "notes": "四种 align 顺序与容器样式按固定上游；中文用 Card，英文用带样式的 Descriptions。"
    },
    {
      "index": 3,
      "name": "Items",
      "zhCN": "descriptions/zh-cn/Items",
      "enUS": "descriptions/en-us/Items",
      "notes": "JSX children 迁移为 DescriptionsItem 默认插槽，itemKey 与数据按固定上游逐字对齐。"
    },
    {
      "index": 4,
      "name": "Vertical",
      "zhCN": "descriptions/zh-cn/Vertical",
      "enUS": "descriptions/en-us/Vertical",
      "notes": "中文保留固定上游纵向布局示例；英文页无对应 live 片段，按已发布示例用同一份英文数据渲染 vertical 布局。"
    },
    {
      "index": 5,
      "name": "Horizontal",
      "zhCN": "descriptions/zh-cn/Horizontal",
      "enUS": "descriptions/en-us/Horizontal",
      "notes": "中文保留 column=5 与上次直播时间，英文保留 column=4 与六项数据。"
    },
    {
      "index": 6,
      "name": "DoubleRow",
      "zhCN": "descriptions/zh-cn/DoubleRow",
      "enUS": "descriptions/en-us/DoubleRow",
      "notes": "row 三种 size 与容器样式按固定上游，去掉迁移时多加的 maxWidth。"
    },
    {
      "index": 7,
      "name": "KeyStyle",
      "zhCN": "descriptions/zh-cn/KeyStyle",
      "enUS": "descriptions/en-us/KeyStyle",
      "notes": "keyStyle 固定宽度与右对齐，四条数据按固定上游逐字对齐。"
    },
    {
      "index": 8,
      "name": "ItemKeyStyle",
      "zhCN": "descriptions/zh-cn/ItemKeyStyle",
      "enUS": "descriptions/en-us/ItemKeyStyle",
      "notes": "DescriptionsItem 的 keyStyle 与三条数据按固定上游逐字对齐。"
    }
  ],
