  "spec": "spin-matrix.spec.ts",
  "locales": ["zh-cn", "en-us"],
  "themes": ["light", "dark"],
  "examples": [
    {
      "index": 1,
      "name": "Basic",
      "zhCN": "spin/zh-cn/Basic",
      "enUS": "spin/en-us/Basic",
      "notes": "复杂节点以 Vue slot 或 h() 提供"
    },
    {
      "index": 2,
      "name": "Size",
      "zhCN": "spin/zh-cn/Size",
      "enUS": "spin/en-us/Size",
      "notes": "保留固定上游参数与交互；Vue props、slots、shallowRef 适配"
    },
    {
      "index": 3,
      "name": "Tip",
      "zhCN": "spin/zh-cn/Tip",
      "enUS": "spin/en-us/Tip",
      "notes": "保留固定上游参数与交互；Vue props、slots、shallowRef 适配"
