{
  "id": "collapse",
  "upstream": "show/collapse",
  "title": "Collapse 文档",
  "spec": "collapse-matrix.spec.ts",
  "locales": ["zh-cn", "en-us"],
  "themes": ["light", "dark"],
  "examples": [
    {
      "index": 1,
      "name": "Basic",
      "zhCN": "collapse/zh-cn/Basic",
      "enUS": "collapse/en-us/Basic",
      "notes": "修正英文上游 ItemKey 大小写笔误为真实公开 itemKey；保留三面板和原文本。"
    },
    {
      "index": 2,
      "name": "Accordion",
      "zhCN": "collapse/zh-cn/Accordion",
      "enUS": "collapse/en-us/Accordion",
      "notes": "保留 accordion 单开语义、三面板与文案；交互验证始终只保留一个展开面板。"
    },
    {
      "index": 3,
      "name": "Disabled",
      "zhCN": "collapse/zh-cn/Disabled",
      "enUS": "collapse/en-us/Disabled",
      "notes": "保留禁用首面板；交互验证禁用面板点击无效、其余面板仍可展开。"
    },
    {
      "index": 4,
      "name": "HideIcon",
      "zhCN": "collapse/zh-cn/HideIcon",
      "enUS": "collapse/en-us/HideIcon",
      "notes": "首面板 showArrow=false；交互验证无图标时标题点击仍可展开。"
    },
    {
      "index": 5,
      "name": "CustomIcon",
      "zhCN": "collapse/zh-cn/CustomIcon",
      "enUS": "collapse/en-us/CustomIcon",
      "notes": "expandIcon/collapseIcon 映射为同名插槽，保留 IconPlus/IconMinus。"
    },
    {
      "index": 6,
      "name": "Extra",
      "zhCN": "collapse/zh-cn/Extra",
      "enUS": "collapse/en-us/Extra",
      "notes": "extra 使用 prop 与同名插槽三种形式，保留 IconCopy 与 Tag。"
    }
  ],
  "inputs": [
