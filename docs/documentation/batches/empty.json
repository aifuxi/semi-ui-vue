{
  "id": "empty",
  "upstream": "show/empty",
  "title": "Empty 文档",
  "spec": "empty-matrix.spec.ts",
  "locales": ["zh-cn", "en-us"],
  "themes": ["light", "dark"],
  "examples": [
    {
      "index": 1,
      "name": "Basic",
      "zhCN": "empty/zh-cn/Basic",
      "enUS": "empty/en-us/Basic",
      "notes": "image/darkModeImage 迁移为同名插槽，插画使用 150x150 尺寸与固定上游文案。"
    },
    {
      "index": 2,
      "name": "Custom",
      "zhCN": "empty/zh-cn/Custom",
      "enUS": "empty/en-us/Custom",
      "notes": "children 迁移为默认插槽，保留两个 Button 的内联样式与胶囊顺序。"
    },
    {
      "index": 3,
      "name": "WithoutImage",
      "zhCN": "empty/zh-cn/WithoutImage",
      "enUS": "empty/en-us/WithoutImage",
      "notes": "description 使用 span + Typography.Text 组合，保留普通文本与 link 文本。"
    },
    {
      "index": 4,
      "name": "Layout",
      "zhCN": "empty/zh-cn/Layout",
      "enUS": "empty/en-us/Layout",
      "notes": "保留 layout=horizontal、宽 800 居中容器与长描述文案。"
    },
    {
      "index": 5,
      "name": "Illustrations",
      "zhCN": "empty/zh-cn/Illustrations",
      "enUS": "empty/en-us/Illustrations",
      "notes": "八张插画、padding 30 与两行换行容器按固定上游保留。"
    }
  ],
