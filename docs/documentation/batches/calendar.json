{
  "id": "calendar",
  "upstream": "show/calendar",
  "title": "Calendar 文档",
  "spec": "calendar-matrix.spec.ts",
  "locales": ["zh-cn", "en-us"],
  "themes": ["light", "dark"],
  "examples": [
    {
      "index": 1,
      "name": "Day",
      "zhCN": "calendar/zh-cn/Day",
      "enUS": "calendar/en-us/Day",
      "notes": "保留上游仅传 mode 的日视图，缺省 displayValue 与 showCurrTime 保持开启；矩阵两侧固定 Date 以保证确定性"
    },
    {
      "index": 2,
      "name": "Week",
      "zhCN": "calendar/zh-cn/Week",
      "enUS": "calendar/en-us/Week",
      "notes": "保留上游仅传 mode 的周视图，缺省 displayValue 与 showCurrTime 保持开启"
    },
    {
      "index": 3,
      "name": "Month",
      "zhCN": "calendar/zh-cn/Month",
      "enUS": "calendar/en-us/Month",
      "notes": "保留上游仅传 mode 的月视图，缺省 displayValue 保持开启"
    },
    {
      "index": 4,
      "name": "WeekStart",
      "zhCN": "calendar/zh-cn/WeekStart",
      "enUS": "calendar/en-us/WeekStart",
      "notes": "保留上游七个周起始日单选、aria-label 与 name；React onChange 迁移为 v-model，交互验证切换后的月份列头"
    },
    {
      "index": 5,
      "name": "Range",
      "zhCN": "calendar/zh-cn/Range",
      "enUS": "calendar/en-us/Range",
      "notes": "保留上游多日视图仅传 range 的写法，不额外注入 displayValue"
    },
    {
      "index": 6,
      "name": "Events",
      "zhCN": "calendar/zh-cn/Events",
      "enUS": "calendar/en-us/Events",
      "notes": "保留上游事件数组、四种 mode 单选与 DatePicker；React children 迁移为 Vue content，交互验证月视图与多日视图切换"
    },
    {
      "index": 7,
      "name": "CustomEvents",
      "zhCN": "calendar/zh-cn/CustomEvents",
      "enUS": "calendar/en-us/CustomEvents",
      "notes": "dateGridRender 迁移为 #dateGrid 作用域插槽，保留绝对定位事件与 2019-07-23 展示日期"
    },
    {
      "index": 8,
      "name": "CellStyle",
      "zhCN": "calendar/zh-cn/CellStyle",
      "enUS": "calendar/en-us/CellStyle",
      "notes": "保留上游四个高亮日期与月视图单元格覆盖"
    },
    {
      "index": 9,
      "name": "DateDisplay",
      "zhCN": "calendar/zh-cn/DateDisplay",
      "enUS": "calendar/en-us/DateDisplay",
      "notes": "renderDateDisplay 迁移为 #dateDisplay 作用域插槽，保留七色小头像与 2023-05-14 展示日期"
    }
  ],
  "inputs": [
    "pnpm-lock.yaml",
    "package.json",
    "apps/docs/package.json",
    "apps/docs/nuxt.config.ts",
    "apps/docs/modules",
    "patches/@nuxt__rspack-builder@4.5.2.patch",
