  ],
  "rtlExamples": [
    "Day",
    "Week",
    "Month",
    "WeekStart",
    "Range",
    "Events",
    "CustomEvents",
    "CellStyle",
    "DateDisplay"
  ],
  "dependencyMode": "imports-v2"
}
