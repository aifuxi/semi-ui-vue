{
  "id": "table-1",
  "upstream": "show/table",
  "title": "Table 文档",
  "spec": "table-1-matrix.spec.ts",
  "locales": ["zh-cn", "en-us"],
  "themes": ["light", "dark"],
  "examples": [
    {
      "index": 1,
      "zhCN": "table/zh-cn/Basic",
      "enUS": "table/en-us/Basic",
      "notes": "固定3行，中6列/英5列，英文无状态列；无列宽。 本批正式状态只以table-1完整证据为准。",
      "name": "Basic"
    },
    {
      "index": 2,
      "zhCN": "table/zh-cn/DeclarativeColumns",
      "enUS": "table/en-us/DeclarativeColumns",
      "notes": "固定3行、5列，无列宽；中文声明式更新列为更新时间。 本批正式状态只以table-1完整证据为准。",
      "name": "DeclarativeColumns"
    },
    {
      "index": 3,
      "zhCN": "table/zh-cn/Selection",
      "enUS": "table/en-us/Selection",
      "notes": "固定6记录/页3，第三条禁选，中6/英5数据列；无额外可见状态文字。 本批正式状态只以table-1完整证据为准。",
      "name": "Selection"
    },
    {
      "index": 4,
      "zhCN": "table/zh-cn/CustomRendering",
      "enUS": "table/en-us/CustomRendering",
      "notes": "固定4行、删除图标按钮、minHeight350、长标题与Empty，中文独有状态列。 本批正式状态只以table-1完整证据为准。",
      "name": "CustomRendering"
    },
    {
      "index": 5,
      "zhCN": "table/zh-cn/Pagination",
      "enUS": "table/en-us/Pagination",
      "notes": "固定46条、页10、scroll.y300、行选择、标题筛选、大小日期排序；中文独有状态列。 本批正式状态只以table-1完整证据为准。",
      "name": "Pagination"
    },
    {
      "index": 6,
      "zhCN": "table/zh-cn/RemoteData",
      "enUS": "table/en-us/RemoteData",
      "notes": "固定46总数/当前页5、300ms本地请求，受控currentPage与Vue pagination.onChange。 本批正式状态只以table-1完整证据为准。",
      "name": "RemoteData"
    },
    {
      "index": 7,
      "zhCN": "table/zh-cn/Fixed",
      "enUS": "table/en-us/Fixed",
      "notes": "46条、固定首末列与复选列、scroll x1200/y300、列宽250/200/200/200/100。 本批正式状态只以table-1完整证据为准。",
      "name": "Fixed"
    },
    {
      "index": 8,
      "zhCN": "table/zh-cn/SortFilter",
      "enUS": "table/en-us/SortFilter",
      "notes": "46条、scroll.y300、行选择、三列排序、名称筛选；中文独有状态列。 本批正式状态只以table-1完整证据为准。",
      "name": "SortFilter"
    },
    {
      "index": 9,
      "zhCN": "table/zh-cn/UndefinedSort",
      "enUS": "table/en-us/UndefinedSort",
      "notes": "固定6条，size=[3,undefined,1,5,undefined,2]，第三sorter参数保证undefined末尾。 本批正式状态只以table-1完整证据为准。",
      "name": "UndefinedSort"
    },
    {
      "index": 10,
      "zhCN": "table/zh-cn/HeaderFilter",
      "enUS": "table/en-us/HeaderFilter",
      "notes": "46条，Space包标题Input；中文日期2024-01-25/D2C首页，英文当前日期/design draft；中文独有状态列。 本批正式状态只以table-1完整证据为准。",
      "name": "HeaderFilter"
    },
    {
      "index": 11,
      "zhCN": "table/zh-cn/CustomFilter",
      "enUS": "table/en-us/CustomFilter",
      "notes": "46条，owner默认筛选23条；标题面板关闭、owner面板不关闭，英文按钮文案仍为Filter+Close。 本批正式状态只以table-1完整证据为准。",
      "name": "CustomFilter"
    },
    {
      "index": 12,
      "zhCN": "table/zh-cn/FilterConfirm",
      "enUS": "table/en-us/FilterConfirm",
      "notes": "20条、Semi Pro首页、2024-01-25、名称列宽300，标题/owner均为确认模式。 本批正式状态只以table-1完整证据为准。",
      "name": "FilterConfirm"
    },
    {
      "index": 13,
      "zhCN": "table/zh-cn/FilterItem",
      "enUS": "table/en-us/FilterItem",
      "notes": "46条、scroll.y300、行选择，自定义Dropdown.Item，showTick:true，名称/大小/日期排序。 本批正式状态只以table-1完整证据为准。",
      "name": "FilterItem"
    },
    {
      "index": 14,
      "zhCN": "table/zh-cn/Expanded",
      "enUS": "table/en-us/Expanded",
      "notes": "固定3条、rowKey=name、首列宽500，选择第三条禁用，展开Descriptions五项。 本批正式状态只以table-1完整证据为准。",
      "name": "Expanded"
    },
    {
      "index": 15,
      "zhCN": "table/zh-cn/SeparateExpand",
      "enUS": "table/en-us/SeparateExpand",
      "notes": "同14并显式hideExpandedColumn=false；保留英文Security Level值中的中文级。 本批正式状态只以table-1完整证据为准。",
      "name": "SeparateExpand"
    }
  ],
