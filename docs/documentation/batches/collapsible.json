{
  "id": "collapsible",
  "upstream": "show/collapsible",
  "title": "Collapsible 文档",
  "spec": "collapsible-matrix.spec.ts",
  "locales": ["zh-cn", "en-us"],
  "themes": ["light", "dark"],
  "examples": [
    {
      "index": 1,
      "name": "Basic",
      "zhCN": "collapsible/zh-cn/Basic",
      "enUS": "collapsible/en-us/Basic",
      "notes": "useState 改 shallowRef；保留中文四条设计原则与英文原诗句，按固定上游不额外附加 aria 关联。"
    },
    {
      "index": 2,
      "name": "Duration",
      "zhCN": "collapsible/zh-cn/Duration",
      "enUS": "collapsible/en-us/Duration",
      "notes": "保留 InputNumber min0/step10/初始250ms 控制动画时长，标签按固定上游使用 label。"
    },
    {
      "index": 3,
      "name": "Nested",
      "zhCN": "collapsible/zh-cn/Nested",
      "enUS": "collapsible/en-us/Nested",
      "notes": "保留父子独立开关与嵌套四条内容，文案按固定上游逐字对齐。"
    },
    {
      "index": 4,
      "name": "CollapseHeight",
      "zhCN": "collapsible/zh-cn/CollapseHeight",
      "enUS": "collapsible/en-us/CollapseHeight",
      "notes": "保留 collapseHeight60、渐变 mask 与 + Show More；按固定上游使用内联样式锚点。"
    }
  ],
