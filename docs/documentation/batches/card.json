    "apps/docs/scripts/documentation-pipeline.mjs",
    "apps/docs/scripts/documentation-preparation-cache.mjs",
    "apps/docs/playwright.nuxt.config.ts",
    "apps/docs/playwright.config.ts",
    "packages/icons/src",
    "packages/theme-default",
    "tests/browser/parity-harness.ts",
    "docs/documentation/batches/card.json",
    "docs/documentation/mappings/card.json",
    "docs/documentation/card-acceptance.md",
    "packages/test-infra/src",
