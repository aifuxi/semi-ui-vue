{
  "id": "card",
  "upstream": "show/card",
  "title": "Card 文档",
  "spec": "card-matrix.spec.ts",
  "locales": ["zh-cn", "en-us"],
  "themes": ["light", "dark"],
  "examples": [
    {
      "index": 1,
      "name": "Basic",
      "zhCN": "card/zh-cn/Basic",
      "enUS": "card/en-us/Basic",
      "notes": "保留标题、正文与额外操作；headerExtraContent 使用同名插槽。"
    },
    {
      "index": 2,
      "name": "Simple",
      "zhCN": "card/zh-cn/Simple",
      "enUS": "card/en-us/Simple",
      "notes": "保留纯正文和 Meta+Popover 两种卡片；头像使用现有本地 photo.svg。"
    },
    {
      "index": 3,
      "name": "Cover",
      "zhCN": "card/zh-cn/Cover",
      "enUS": "card/en-us/Cover",
      "notes": "cover prop 映射 cover 插槽；使用现有本地 poster.svg 保证离线资源可用。"
    },
    {
      "index": 4,
      "name": "Border",
      "zhCN": "card/zh-cn/Border",
      "enUS": "card/en-us/Border",
      "notes": "保留 bordered=false、headerLine=true 与背景容器。"
    },
    {
      "index": 5,
      "name": "Shadows",
      "zhCN": "card/zh-cn/Shadows",
      "enUS": "card/en-us/Shadows",
      "notes": "保留 hover/always 两种阴影与 Meta+Popover；交互验证 hover 阴影终态。"
    },
    {
      "index": 6,
      "name": "Flexible",
      "zhCN": "card/zh-cn/Flexible",
      "enUS": "card/en-us/Flexible",
      "notes": "title/cover/footer 等 VNode 改具名插槽，保持尺寸、按钮与布局。"
    },
    {
      "index": 7,
      "name": "Inner",
      "zhCN": "card/zh-cn/Inner",
      "enUS": "card/en-us/Inner",
      "notes": "保留两个内部 Card、标题额外操作与间距。"
    },
    {
      "index": 8,
      "name": "Grid",
      "zhCN": "card/zh-cn/Grid",
      "enUS": "card/en-us/Grid",
      "notes": "保留 gutter=[16,16] 两行及 span8/16 布局。"
    },
    {
      "index": 9,
      "name": "Loading",
      "zhCN": "card/zh-cn/Loading",
      "enUS": "card/en-us/Loading",
      "notes": "useState 改 shallowRef；Switch 控制 loading 的取反状态。"
    },
    {
      "index": 10,
      "name": "Skeleton",
      "zhCN": "card/zh-cn/Skeleton",
      "enUS": "card/en-us/Skeleton",
      "notes": "保留 title/description/avatar/extra/cover 五个独立 Skeleton 占位；使用同名插槽。"
    },
    {
      "index": 11,
      "name": "Tabs",
      "zhCN": "card/zh-cn/Tabs",
      "enUS": "card/en-us/Tabs",
      "notes": "保留两个 TabPane 与各三段内容、负20px上下边距。"
    },
    {
      "index": 12,
      "name": "Actions",
      "zhCN": "card/zh-cn/Actions",
      "enUS": "card/en-us/Actions",
      "notes": "actions 数组改 actions 插槽，保留四星 Rating。"
    },
    {
      "index": 13,
      "name": "Group",
      "zhCN": "card/zh-cn/Group",
      "enUS": "card/en-us/Group",
      "notes": "保留八张卡片和10至40的间距调节；Slider change 更新 shallowRef。"
    },
    {
      "index": 14,
      "name": "GridGroup",
      "zhCN": "card/zh-cn/GridGroup",
      "enUS": "card/en-us/GridGroup",
      "notes": "保留七张卡片及 CardGroup type=grid。"
    }
  ],
  "inputs": [
    "pnpm-lock.yaml",
    "package.json",
    "apps/docs/package.json",
    "apps/docs/nuxt.config.ts",
    "apps/docs/modules",
    "patches/@nuxt__rspack-builder@4.5.2.patch",
    "apps/docs/content/zh-cn/components/card.md",
    "apps/docs/content/en-us/components/card.md",
    "apps/docs/src/demos/card",
    "apps/docs/src/assets",
    "apps/docs/src/components",
    "apps/docs/scripts/prepare-*.mjs",
    "apps/docs/scripts/repl-module-bundles.mjs",
    "apps/docs/scripts/repl-rslib-factories.mjs",
    "apps/docs/scripts/*-loader.mjs",
    "apps/docs/scripts/static-file-response.mjs",
    "apps/docs/scripts/preview-static.mjs",
    "apps/docs/scripts/verify-dist.mjs",
    "apps/docs/scripts/verify-content.mjs",
    "apps/docs/scripts/accept-documentation-batch.mjs",
    "apps/docs/scripts/documentation-evidence.mjs",
