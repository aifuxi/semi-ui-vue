{
  "name": "@workspace/theme-default",
  "version": "0.0.0",
  "private": true,
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "style": "./dist/index.css",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "style": "./dist/index.css",
      "default": "./dist/index.css"
    },
    "./index.css": "./dist/index.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rimraf dist && sass --no-source-map --no-charset src/index.scss dist/index.css && node ../../scripts/write-compliance-artifacts.mjs .",
    "clean": "rimraf dist"
  },
  "devDependencies": {
    "sass": "1.54.9"
  }
}
