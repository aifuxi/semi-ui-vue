{
  "name": "@workspace/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./button": {
      "types": "./dist/button/index.d.ts",
      "import": "./dist/button/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rimraf dist && vite build && node ../../scripts/write-compliance-artifacts.mjs .",
    "typecheck": "vue-tsc --noEmit",
    "clean": "rimraf dist"
  },
  "devDependencies": {
    "@workspace/foundation-integration": "workspace:*"
  },
  "peerDependencies": {
    "vue": ">=3.5.0"
  }
}
