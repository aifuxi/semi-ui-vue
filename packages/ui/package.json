{
  "name": "@workspace/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./auto-complete": {
      "types": "./dist/auto-complete/index.d.ts",
      "import": "./dist/auto-complete/index.js"
    },
    "./button": {
      "types": "./dist/button/index.d.ts",
      "import": "./dist/button/index.js"
    },
    "./checkbox": {
      "types": "./dist/checkbox/index.d.ts",
      "import": "./dist/checkbox/index.js"
    },
    "./config-provider": {
      "types": "./dist/config-provider/index.d.ts",
      "import": "./dist/config-provider/index.js"
    },
    "./divider": {
      "types": "./dist/divider/index.d.ts",
      "import": "./dist/divider/index.js"
    },
    "./float-button": {
      "types": "./dist/float-button/index.d.ts",
      "import": "./dist/float-button/index.js"
    },
    "./grid": {
      "types": "./dist/grid/index.d.ts",
      "import": "./dist/grid/index.js"
    },
    "./icon": {
      "types": "./dist/icon/index.d.ts",
      "import": "./dist/icon/index.js"
    },
    "./input": {
      "types": "./dist/input/index.d.ts",
      "import": "./dist/input/index.js"
    },
    "./layout": {
      "types": "./dist/layout/index.d.ts",
      "import": "./dist/layout/index.js"
    },
    "./resizable": {
      "types": "./dist/resizable/index.d.ts",
      "import": "./dist/resizable/index.js"
    },
    "./select": {
      "types": "./dist/select/index.d.ts",
      "import": "./dist/select/index.js"
    },
    "./space": {
      "types": "./dist/space/index.d.ts",
      "import": "./dist/space/index.js"
    },
    "./switch": {
      "types": "./dist/switch/index.d.ts",
      "import": "./dist/switch/index.js"
    },
    "./tooltip": {
      "types": "./dist/tooltip/index.d.ts",
      "import": "./dist/tooltip/index.js"
    },
    "./typography": {
      "types": "./dist/typography/index.d.ts",
      "import": "./dist/typography/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rimraf dist && vite build && node ../../scripts/write-compliance-artifacts.mjs .",
    "typecheck": "vue-tsc --noEmit",
    "clean": "rimraf dist"
  },
  "devDependencies": {
    "@workspace/foundation-integration": "workspace:*"
  },
  "dependencies": {
    "@workspace/icons": "workspace:*",
    "lodash": "4.17.21"
  },
  "peerDependencies": {
    "vue": ">=3.5.0"
  }
}
