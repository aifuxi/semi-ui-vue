{
  "name": "@aifuxi/semi-illustrations-vue",
  "version": "0.1.0-alpha.4",
  "description": "Semi Design v2.102.0 illustrations generated as Vue 3 components.",
  "license": "MIT",
  "author": "aifuxi",
  "keywords": [
    "semi-design",
    "vue",
    "illustrations",
    "svg",
    "components"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aifuxi/semi-ui-vue.git",
    "directory": "packages/illustrations"
  },
  "homepage": "https://github.com/aifuxi/semi-ui-vue#readme",
  "bugs": {
    "url": "https://github.com/aifuxi/semi-ui-vue/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "next"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "LICENSE",
    "README.md",
    "dist"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./Illustration": {
      "types": "./dist/components/Illustration.d.ts",
      "import": "./dist/components/Illustration.js"
    },
    "./illustrations/*": {
      "types": "./dist/illustrations/*.d.ts",
      "import": "./dist/illustrations/*.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node ../../scripts/generate-illustrations.mjs --check && rimraf dist && vite build && node ../../scripts/write-compliance-artifacts.mjs .",
    "typecheck": "vue-tsc --noEmit",
    "clean": "rimraf dist"
  },
  "peerDependencies": {
    "vue": ">=3.5.0"
  }
}
